  command = ${LAUNCHER}${CODE_CHECK}/usr/bin/clang++ --target=x86_64-unknown-elf $DEFINES $INCLUDES $FLAGS -MD -MT $out -MF $DEP_FILE -o $out -c $in
  description = Building CXX object $out


