# Rule for linking CXX executable.

rule CXX_EXECUTABLE_LINKER__nvme_
  command = $PRE_LINK && /usr/bin/clang++ --target=x86_64-unknown-elf $FLAGS $LINK_FLAGS $in -o $TARGET_FILE $LINK_PATH $LINK_LIBRARIES && $POST_BUILD
  description = Linking CXX executable $TARGET_FILE
  restat = $RESTAT


#############################################
# Rule for generating CXX dependencies.

rule CXX_SCAN__ahci_
  depfile = $DEP_FILE
  command = "/usr/bin/clang-scan-deps-21" -format=p1689 -- /usr/bin/clang++ --target=x86_64-unknown-elf $DEFINES $INCLUDES $FLAGS -x c++ $in -c -o $OBJ_FILE -resource-dir "/usr/lib/llvm-21/lib/clang/21" -MT $DYNDEP_INTERMEDIATE_FILE -MD -MF $DEP_FILE > $DYNDEP_INTERMEDIATE_FILE.tmp && mv $DYNDEP_INTERMEDIATE_FILE.tmp $DYNDEP_INTERMEDIATE_FILE
  description = Scanning $in for CXX dependencies


#############################################
# Rule to generate ninja dyndep files for CXX.

rule CXX_DYNDEP__ahci_
  command = /usr/bin/cmake -E cmake_ninja_dyndep --tdi=user/CMakeFiles/ahci.dir/CXXDependInfo.json --lang=CXX --modmapfmt=clang --dd=$out @$out.rsp
  description = Generating CXX dyndep file $out
  rspfile = $out.rsp
  rspfile_content = $in
  restat = 1


