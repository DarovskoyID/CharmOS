build tools/mkdisk/CMakeFiles/mkdisk.dir/mkdisk.cpp.o: CXX_COMPILER__mkdisk_unscanned_Debug /mnt/a/CharmOS/tools/mkdisk/mkdisk.cpp || cmake_object_order_depends_target_mkdisk
  CONFIG = Debug
  DEP_FILE = tools/mkdisk/CMakeFiles/mkdisk.dir/mkdisk.cpp.o.d
  FLAGS = -g -std=c++23 -Wall -Wextra -Werror -Wshadow -Wconversion -Wsign-conversion -Wnull-dereference -fno-exceptions -fno-rtti
  INCLUDES = -I/mnt/a/CharmOS/lib/fs/include -I/mnt/a/CharmOS/lib/core/include
  OBJECT_DIR = tools/mkdisk/CMakeFiles/mkdisk.dir
  OBJECT_FILE_DIR = tools/mkdisk/CMakeFiles/mkdisk.dir
  TARGET_COMPILE_PDB = tools/mkdisk/CMakeFiles/mkdisk.dir/
  TARGET_PDB = tools/mkdisk/mkdisk.pdb
  TARGET_SUPPORT_DIR = tools/mkdisk/CMakeFiles/mkdisk.dir


# =============================================================================
# Link build statements for EXECUTABLE target mkdisk


#############################################
# Link the executable tools/mkdisk/mkdisk

build tools/mkdisk/mkdisk: CXX_EXECUTABLE_LINKER__mkdisk_Debug tools/mkdisk/CMakeFiles/mkdisk.dir/mkdisk.cpp.o | lib/fs/libfs.a lib/core/libcore.a || lib/core/libcore.a lib/fs/libfs.a
  CONFIG = Debug
  DEP_FILE = tools/mkdisk/CMakeFiles/mkdisk.dir/link.d
  FLAGS = -g
  LINK_FLAGS = -Xlinker --dependency-file=tools/mkdisk/CMakeFiles/mkdisk.dir/link.d
  LINK_LIBRARIES = lib/fs/libfs.a  lib/core/libcore.a
  OBJECT_DIR = tools/mkdisk/CMakeFiles/mkdisk.dir
  POST_BUILD = :
  PRE_LINK = :
  TARGET_COMPILE_PDB = tools/mkdisk/CMakeFiles/mkdisk.dir/
  TARGET_FILE = tools/mkdisk/mkdisk
  TARGET_PDB = tools/mkdisk/mkdisk.pdb
  TARGET_SUPPORT_DIR = tools/mkdisk/CMakeFiles/mkdisk.dir


#############################################
# Utility command for test

build tools/mkdisk/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/a/CharmOS/build2/host/tools/mkdisk && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build tools/mkdisk/test: phony tools/mkdisk/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build tools/mkdisk/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/a/CharmOS/build2/host/tools/mkdisk && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build tools/mkdisk/edit_cache: phony tools/mkdisk/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build tools/mkdisk/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /mnt/a/CharmOS/build2/host/tools/mkdisk && /usr/bin/cmake --regenerate-during-build -S/mnt/a/CharmOS -B/mnt/a/CharmOS/build2/host
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build tools/mkdisk/rebuild_cache: phony tools/mkdisk/CMakeFiles/rebuild_cache.util

