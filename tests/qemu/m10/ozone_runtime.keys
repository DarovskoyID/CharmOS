#wait Native Ozone: delegate resize ready for input
#sleep 1
#pixel 280 270
#monitor sendkey a
#wait Native Ozone: keyboard raw and text events rendered
#sleep 1
#pixel 330 270
#monitor mouse_move -100 -50
#sleep 1
#monitor mouse_button 1
#monitor mouse_button 0
#monitor mouse_move 0 0 1
#wait Native Ozone: pointer button and wheel events ok
#monitor screendump /mnt/a/CharmOS/build/ozone-runtime.ppm
#monitor sendkey esc
#wait Native Ozone: closed
svc poweroff
