# M10 (фазы 6–7): два процесса рисуют в своих окнах (docs/abi/wm.md), окно
# двигается мышью за заголовок, задержка «ввод → пиксель» измерена.
[wm] wm: ready (input yes, door yes)
[wdemo] wdemo amber: window
[wdemo] wdemo ember: window
[wm] wm: window 1 moved to 280,380
[wdemo] wdemo amber: key 0x4
[wdemo] wdemo amber: input->pixel
init: poweroff: stopping services
# До перетаскивания: в окне amber (содержимое 80,104) — его цвет, в ember (380,254) — свой.
screen: pixel 90,150 = f5c518
screen: pixel 400,330 = ff8a00
# После: amber переехал на +200,+300 (содержимое 280,404), на старом месте — фон.
screen: pixel 90,150 = 0b0b0c
screen: pixel 290,450 = f5c518
