{
  "homepage": "https://yandex.ru/",
  "homepage_is_newtabpage": false,
  "session": {
    "restore_on_startup": 4,
    "startup_urls": [ "https://yandex.ru/" ]
  },
  "default_search_provider_data": {
    "template_url_data": {
      "short_name": "Яндекс",
      "keyword": "yandex.ru",
      "url": "https://yandex.ru/search/?text={searchTerms}",
      "suggestions_url": "https://suggest.yandex.ru/suggest-ya.cgi?part={searchTerms}",
      "favicon_url": "https://yandex.ru/favicon.ico",
      "encoding": "UTF-8",
      "safe_for_autoreplace": true
    }
  },
  "distribution": {
    "skip_first_run_ui": true,
    "suppress_default_browser_prompt": true,
    "import_bookmarks": false,
    "import_history": false,
    "import_home_page": false,
    "import_search_engine": false
  }
}
