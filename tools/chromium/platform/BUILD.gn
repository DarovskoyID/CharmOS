import("//build/toolchain/gcc_toolchain.gni")
import("toolchain-revision.gni")
import("numeric-sources.gni")

declare_args() {
  charmos_repo = ""
  charmos_build_base = false
}
assert(charmos_repo != "", "Set charmos_repo to the native CharmOS checkout")

gcc_toolchain("clang_x64") {
  cc = rebase_path("cc-" + charmos_toolchain_revision, root_build_dir)
  cxx = rebase_path("cxx-" + charmos_toolchain_revision, root_build_dir)
  ld = rebase_path("link-" + charmos_toolchain_revision, root_build_dir)
  ar = rebase_path("ar-" + charmos_toolchain_revision, root_build_dir)
  nm = rebase_path("//third_party/llvm-build/Release+Asserts/bin/llvm-nm", root_build_dir)
  readelf = rebase_path("//third_party/llvm-build/Release+Asserts/bin/llvm-readelf", root_build_dir)
  toolchain_args = {
    current_cpu = "x64"
    current_os = "charmos"
    use_remoteexec = false
  }
  executable_extension = ".elf"
}

source_set("bootstrap_runtime") {
  sources = [
    "//third_party/libc++/src/src/algorithm.cpp",
    "//third_party/libc++/src/src/verbose_abort.cpp",
  ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [
    "//build/config/compiler:no_chromium_code",
    "//buildtools/third_party/libc++:config",
  ]
}

executable("platform_smoke") {
  # Bootstrap probe: explicit upstream units, not a claim that full libc++ or
  # //base already links. The normal runtime target below keeps all missing
  # libc/locale/filesystem dependencies visible during porting.
  no_default_deps = true
  sources = [ "platform_smoke.cc" ]
  libs = [ "$charmos_repo/build/user/user/libc.a" ]
  deps = [ ":bootstrap_runtime" ]
}

executable("full_runtime") {
  # Normal executable dependencies pull in the complete upstream runtime.
  sources = [ "runtime_checks.cc" ]
  libs = [ "$charmos_repo/build/user/user/libc.a" ]
  deps = [ ":numeric_runtime" ]
}

executable("json_runtime") {
  sources = [ "json_checks.cc" ]
  libs = [ "$charmos_repo/build/user/user/libc.a" ]
  deps = [ ":numeric_runtime" ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
}

static_library("numeric_runtime") {
  sources = charmos_numeric_sources
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_COPT_PUBLIC_PACKAGING",
    "__CHARMOS_NUMERIC_RUNTIME__=1",
    "LIBC_ERRNO_MODE=LIBC_ERRNO_MODE_SYSTEM_INLINE",
  ]
  cflags = [ "-fno-builtin" ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
  public_deps = [ ":stdio_engine" ]
}

config("stdio_engine_link") {
  # A weak reference in native libc alone does not extract archive members.
  ldflags = [ "-Wl,-u,__charm_numeric_vsnprintf", "-Wl,-u,fegetenv", "-Wl,-u,fesetenv" ]
}

static_library("stdio_engine") {
  sources = charmos_stdio_sources + [ "numeric_stdio.cc", "math_errno.cc" ]
  include_dirs = [ "//third_party/llvm-libc/src" ]
  defines = [
    "LIBC_NAMESPACE=__llvm_libc_cr",
    "LIBC_ERRNO_MODE=LIBC_ERRNO_MODE_SYSTEM_INLINE",
  ]
  cflags = [ "-fno-builtin" ]
  configs -= [ "//build/config/compiler:chromium_code" ]
  configs += [ "//build/config/compiler:no_chromium_code" ]
  all_dependent_configs = [ ":stdio_engine_link" ]
}

group("base_port") {
  deps = [ ":platform_smoke", ":full_runtime" ]
  if (charmos_build_base) {
    deps += [ ":base_runtime" ]
  }
}

if (charmos_build_base) {
  executable("base_runtime") {
    sources = [ "base_checks.cc" ]
    libs = [ "$charmos_repo/build/user/user/libc.a" ]
    deps = [ "//base", ":numeric_runtime" ]
  }
}
