# M8.5: системный диск с закрытой областью (store.sh) и сеть.
-device intel-iommu
-drive if=none,id=d0,format=raw,file=build/disk-store.img
-device virtio-blk-pci,drive=d0,disable-legacy=on,iommu_platform=on
-nic none
-netdev user,id=n0
-device virtio-net-pci,netdev=n0,disable-legacy=on,iommu_platform=on
