-display none
-device intel-iommu
-device ich9-intel-hda,id=hda
-audiodev wav,id=audio0,path=build/hda-output.wav,out.frequency=48000,out.channels=2,out.format=s16
-device hda-duplex,bus=hda.0,audiodev=audio0
-drive if=none,id=d0,format=raw,file=build/disk-hda.img
-device virtio-blk-pci,drive=d0,disable-legacy=on,iommu_platform=on
-nic none
